generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Card {
  id             Int      @id @default(autoincrement())
  question       String
  confidence     Int
  createdAt      DateTime @default(now())
  lastReviewedAt DateTime @default(now())
  /// When the card's priority reaches DUE_THRESHOLD. Null for cards created before this field existed.
  dueAt          DateTime?

  @@index([dueAt])
}
