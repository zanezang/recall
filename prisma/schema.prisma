generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Card {
  id             Int             @id @default(autoincrement())
  question       String
  confidence     Int
  createdAt      DateTime        @default(now())
  lastReviewedAt DateTime        @default(now())
  levelTimes     CardLevelTime[]
}

/// The moment a card's priority reaches one threshold level. Each card has one row per level.
model CardLevelTime {
  cardId    Int
  level     Int
  crossesAt DateTime
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, level]) // One row per card per level; finds a card's rows on review
  @@index([level, crossesAt]) // Finds the cards that have crossed a level by a given time
}
