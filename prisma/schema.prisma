generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Card {
  id             Int      @id @default(autoincrement())
  question       String
  confidence     Int
  createdAt      DateTime @default(now())
  lastReviewedAt DateTime @default(now())
  levels         CardLevel[]
}

/// The moment a card's priority reaches one threshold level. Each card has one row per level.
model CardLevel {
  cardId    Int
  level     Int
  crossesAt DateTime
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, level])
  @@index([level, crossesAt])
}
